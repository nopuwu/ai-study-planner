# Skopiuj ten plik do .env i uzupełnij wartości: cp .env.example .env
# Plik .env jest w .gitignore i nie trafia do repozytorium.

# Baza danych PostgreSQL
POSTGRES_DB=spl
POSTGRES_USER=spl
POSTGRES_PASSWORD=zmien_to_haslo
POSTGRES_PORT=5432

# Backend: klucz API modelu AI oraz klucz JWT (backend wymaga wartości przy starcie; na razie wystarczy testowa)
AI_API_KEY=testowy_klucz
JWT_SECRET_KEY=wygenerowany_klucz_tutaj

# Porty na komputerze (zmień, jeśli są zajęte)
BACKEND_PORT=8000
FRONTEND_PORT=5173
